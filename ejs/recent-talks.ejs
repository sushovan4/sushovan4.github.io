<%
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function fmtDateline(d) {
  if (!d) return '';
  const dt = (d instanceof Date) ? d : new Date(d);
  if (isNaN(dt)) return '';
  return months[dt.getUTCMonth()] + ' ' + dt.getUTCFullYear();
}
%><div class="list"><% for (const item of items) { %><% const up = item.date && new Date(item.date) > new Date(); %><div class="dispatch item<%= up ? ' upcoming' : '' %>"><span class="dateline"><%= item.place %>, <%= fmtDateline(item.date) %> &mdash;</span> <% const L = item.links || {}; const href = L.url || L.Slides || L.YouTube || L.DOI || L.pdf || Object.values(L)[0]; %><em><% if (href) { %><a href="<%= href %>"><%- item.title %></a><% } else { %><%- item.title %><% } %></em></div>
<% } %></div>
